# Copy to .env and replace both required secrets. Never commit .env.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
ENABLE_INGESTION_WORKER=true
TASK_LEASE_SECONDS=120
SESSION_SECRET=
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=filemind_session
STORAGE_ROOT=/data/files
MODEL_CACHE_DIR=/data/models
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_REVISION=46fbe35fd4374a00fee7de77dfddaeb6dd6a2c59
EMBEDDING_DIM=512
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=90
AI_ENABLED=true
OCR_BACKEND=rapidocr
MAX_UPLOAD_BYTES=52428800
MAX_EXPORT_BYTES=524288000
MAX_PDF_PAGES=200
USER_QUOTA_BYTES=2147483648
OCR_CONCURRENCY=1
AGENT_CONCURRENCY=2
AGENT_DAILY_RUNS=100
EXPORT_CONCURRENCY=1
RUN_MAX_LLM_CALLS=8
RUN_MAX_TOOL_CALLS=12
RUN_MAX_INPUT_TOKENS=32000
RUN_MAX_OUTPUT_TOKENS=8000
RUN_ACTIVE_TIMEOUT_SECONDS=300
APPROVAL_TTL_HOURS=24
EXPORT_TTL_HOURS=24
TRASH_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90

# Host-only port binds for local development. Keep loopback bindings on a server
# behind a TLS-terminating reverse proxy.
API_BIND=127.0.0.1:8000
POSTGRES_BIND=127.0.0.1:5433
REDIS_BIND=127.0.0.1:6380
WEB_BIND=127.0.0.1:8080
