# Design v0.1: names to be implemented and validated during development.
# Copy to .env locally. Never commit secrets.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=
ENABLE_INGESTION_WORKER=false
TASK_LEASE_SECONDS=120
SESSION_SECRET=
STORAGE_ROOT=/data/files
MODEL_CACHE_DIR=/data/models
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_MODEL_REVISION=
EMBEDDING_DIM=512
OCR_BACKEND=rapidocr
MAX_UPLOAD_BYTES=52428800
MAX_PDF_PAGES=200
USER_QUOTA_BYTES=2147483648
OCR_CONCURRENCY=1
AGENT_CONCURRENCY=2
EXPORT_CONCURRENCY=1
RUN_MAX_LLM_CALLS=8
RUN_MAX_TOOL_CALLS=12
RUN_MAX_INPUT_TOKENS=32000
RUN_MAX_OUTPUT_TOKENS=8000
RUN_ACTIVE_TIMEOUT_SECONDS=300
APPROVAL_TTL_HOURS=24
EXPORT_TTL_HOURS=24
TRASH_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=7
AUDIT_RETENTION_DAYS=90
